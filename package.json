{
  "name": "moyosola-gift-game",
  "version": "1.0.2",
  "description": "Two-player relationship guessing game for Render (Create/Join, 1000 shuffled questions, modern UI).",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "client": "cd client && npm run dev",
    "server": "node server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "dependencies": {
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "nanoid": "^5.0.7"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
